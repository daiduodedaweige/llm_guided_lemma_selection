<mxfile host="app.diagrams.net" type="device">
  <diagram id="swap2-compact-example" name="swap2 归纳检查示例">
    <mxGraphModel dx="1200" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="590" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="top_rule" value="" style="shape=rectangle;fillColor=#111111;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="22" width="1100" height="3" as="geometry"/></mxCell>
        <mxCell id="title" value="示例：swap2 的一步归纳检查与组合修复" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="68" y="30" width="1050" height="43" as="geometry"/></mxCell>
        <mxCell id="title_rule" value="" style="shape=rectangle;fillColor=#111111;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="81" width="1100" height="2" as="geometry"/></mxCell>
        <mxCell id="given" value="&lt;b&gt;已知：&lt;/b&gt;Init = (a,b,c) = (1,5,7)；T : (a′,b′,c′) = (b,c,a)；K = {1,5,7}；p : a ∈ K。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="78" y="94" width="1040" height="37" as="geometry"/></mxCell>
        <mxCell id="candidates" value="&lt;b&gt;候选：&lt;/b&gt;ℓ₂ : b ∈ K；ℓ₃ : c ∈ K。先检查 S₀ = {ℓ₂}，再检查 S* = {ℓ₂,ℓ₃}。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="78" y="136" width="1040" height="37" as="geometry"/></mxCell>
        <mxCell id="body_rule" value="" style="shape=rectangle;fillColor=#777777;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="187" width="1100" height="1" as="geometry"/></mxCell>
        <mxCell id="num_1" value="1" style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="64" y="208" width="33" height="35" as="geometry"/></mxCell>
        <mxCell id="line_1" value="令 I₀ = p ∧ ℓ₂。Init ∧ ¬I₀ 不可满足，初始性通过。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="114" y="208" width="1000" height="38" as="geometry"/></mxCell>
        <mxCell id="num_2" value="2" style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="64" y="256" width="33" height="35" as="geometry"/></mxCell>
        <mxCell id="line_2" value="I₀(x) ∧ T(x,x′) ∧ ¬I₀(x′) 可满足：x = (1,5,0)，x′ = (5,0,1)。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="114" y="256" width="1000" height="51" as="geometry"/></mxCell>
        <mxCell id="num_3" value="3" style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="64" y="313" width="33" height="35" as="geometry"/></mxCell>
        <mxCell id="line_3" value="由于 b′ = 0 ∉ K，ℓ₂′ 不成立；因此 S₀ 的归纳保持失败。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="114" y="313" width="1000" height="42" as="geometry"/></mxCell>
        <mxCell id="num_4" value="4" style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="64" y="364" width="33" height="35" as="geometry"/></mxCell>
        <mxCell id="line_4" value="加入 ℓ₃，令 I* = p ∧ ℓ₂ ∧ ℓ₃。反例源状态的 c = 0 ∉ K，因此被排除。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="114" y="364" width="1000" height="54" as="geometry"/></mxCell>
        <mxCell id="num_5" value="5" style="text;html=1;align=right;verticalAlign=top;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="64" y="426" width="33" height="35" as="geometry"/></mxCell>
        <mxCell id="line_5" value="Init ∧ ¬I* 与 I*(x) ∧ T(x,x′) ∧ ¬I*(x′) 均不可满足；故 S* 可证明 p。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="114" y="426" width="1000" height="61" as="geometry"/></mxCell>
        <mxCell id="bottom_rule" value="" style="shape=rectangle;fillColor=#111111;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="1100" height="3" as="geometry"/></mxCell>
        <mxCell id="scope_note" value="注：这是对一个候选组合的示意检查，不表示实际 LLM 的生成顺序。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="68" y="523" width="1060" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
