<mxfile host="app.diagrams.net" type="device">
  <diagram id="swap2-motivating-example" name="swap2 动机示例">
    <mxGraphModel dx="1200" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="swap2：可达状态与归纳步骤反例" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=23;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="60" y="18" width="1080" height="48" as="geometry"/></mxCell>
        <mxCell id="model" value="初始状态：Init = (a,b,c) = (1,5,7)&lt;br&gt;转移关系：T : (a′,b′,c′) = (b,c,a)　　K = {1,5,7}　　目标属性：p : a ∈ K" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F3F4F6;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=16;fontColor=#111827;spacing=8;" vertex="1" parent="1"><mxGeometry x="85" y="78" width="1030" height="67" as="geometry"/></mxCell>
        <mxCell id="reachable_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="163" width="1070" height="207" as="geometry"/></mxCell>
        <mxCell id="reachable_heading" value="① 从初始状态出发的可达轨迹" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="94" y="174" width="490" height="31" as="geometry"/></mxCell>
        <mxCell id="reachable_note" value="三个状态都满足 p ∧ ℓ₂ ∧ ℓ₃" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="680" y="176" width="410" height="27" as="geometry"/></mxCell>
        <mxCell id="reach_a" value="&lt;b&gt;(1, 5, 7)&lt;/b&gt;&lt;br&gt;初始状态" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=18;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="150" y="224" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="reach_b" value="&lt;b&gt;(5, 7, 1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=18;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="480" y="224" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="reach_c" value="&lt;b&gt;(7, 1, 5)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=18;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="810" y="224" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="edge_ab" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontColor=#1E40AF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="reach_a" target="reach_b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_bc" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontColor=#1E40AF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="reach_b" target="reach_c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_ca" value="T：返回初始状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontColor=#1E40AF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="reach_c" target="reach_a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="339"/><mxPoint x="270" y="339"/></Array></mxGeometry></mxCell>
        <mxCell id="induction_panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="65" y="390" width="1070" height="283" as="geometry"/></mxCell>
        <mxCell id="induction_heading" value="② 对示意组合 S₀ = {ℓ₂} 的一步归纳检查" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="94" y="400" width="720" height="31" as="geometry"/></mxCell>
        <mxCell id="induction_note" value="归纳步骤会检查满足前件的状态，其中也可能包含不可达状态。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="100" y="432" width="990" height="26" as="geometry"/></mxCell>
        <mxCell id="source_x" value="&lt;b&gt;源状态 x = (1, 5, 0)&lt;/b&gt;&lt;br&gt;p ✓，ℓ₂ ✓；ℓ₃ ✗&lt;br&gt;不可达状态" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=17;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="145" y="475" width="285" height="102" as="geometry"/></mxCell>
        <mxCell id="successor_x" value="&lt;b&gt;后继 x′ = (5, 0, 1)&lt;/b&gt;&lt;br&gt;ℓ₂′ 不成立：b′ = 0 ∉ K" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontSize=17;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="570" y="475" width="285" height="102" as="geometry"/></mxCell>
        <mxCell id="edge_counterexample" value="T" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontColor=#991B1B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="source_x" target="successor_x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="failure" value="S₀ 的归纳步骤失败" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="885" y="493" width="205" height="64" as="geometry"/></mxCell>
        <mxCell id="repair" value="&lt;b&gt;加入 ℓ₃：&lt;/b&gt;源状态的 c = 0 ∉ K，因此该反例被排除。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=1.5;fontSize=16;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="145" y="601" width="625" height="54" as="geometry"/></mxCell>
        <mxCell id="proof" value="S* = {ℓ₂, ℓ₃}&lt;br&gt;初始性与归纳保持均成立" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="810" y="596" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="edge_repair" value="组合修复" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1.7;endArrow=block;endFill=1;fontSize=13;fontColor=#166534;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="repair" target="proof"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="scope_note" value="图中 S₀ 与检查顺序仅用于说明选择机制，并非实际 LLM 输出；效率结论需由实验评估。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="85" y="691" width="1030" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
